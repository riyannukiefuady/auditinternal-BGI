PORT=3000
HOST=0.0.0.0
TZ=Asia/Jakarta
# Folder penyimpanan permanen. Di Render gunakan /var/data.
DATA_DIR=
# Jam pengingat harian (0-23)
JAM_KIRIM=7
# Token API Fonnte; simpan sebagai environment variable rahasia di hosting.
FONNTE_TOKEN=
# Ekspor bulanan dikirim ke surel ini bila SMTP diisi.
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Isi dengan kata sandi admin awal yang kuat sebelum deployment.
ADMIN_PASSWORD=
